{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ontology.schema.json",
  "title": "领域本体契约",
  "version": "1.0.0",
  "owner": "B",
  "status": "frozen",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "classes", "relations", "history"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "synonyms", "std_refs", "align_status"],
        "properties": {
          "label": { "type": "string" },
          "synonyms": { "type": "array", "items": { "type": "string" } },
          "std_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["doid", "mondo", "icd10"],
            "properties": {
              "doid":  { "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^DOID:[0-9]+$"}] },
              "mondo": { "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^MONDO:[0-9]{7}$"}] },
              "icd10": { "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][0-9]{2}(\\.[0-9A-Z]{1,4})?$"}] }
            }
          },
          "align_status": { "enum": ["pending", "aligned", "rejected"] }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "predicate", "object"],
        "properties": {
          "subject": { "type": "string" },
          "predicate": { "const": "has_symptom" },
          "object": { "type": "string" }
        }
      }
    },
    "history": { "type": "array" }
  }
}
